action forme
var choix, N, i, j : entier

debut
	sortir("1 = carré, 2 = triangle : ")
	entrer(choix)
	sortir("Taille N : ")
	entrer(N)
	si (choix = 1) alors
		pour i allant de 1 a N faire
			pour j allant de 1 a N faire
				sortir("*")
			fpour
			retour a la ligne
		fpour
	sinon
		pour i allant de 1 a N faire
			pour j allant de 1 a i faire
				sortir("*")
			fpour
			retour a la ligne
		fpour
	fsi
fin
