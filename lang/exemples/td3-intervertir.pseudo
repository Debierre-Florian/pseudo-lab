// TD3 ex3 : la procédure intervertir échange deux variables (paramètres « var »)
action On_inverse_en_masse

procedure intervertir(var x : entier, var y : entier)
var
	Temp : entier
debut
	Temp <- x
	x <- y
	y <- Temp
fin

var
	X1, Y1, X2, Y2, X3, Y3 : entier
debut
	sortir("Entrez 6 entiers : ")
	entrer(X1, Y1, X2, Y2, X3, Y3)
	si X1 > Y1 alors
		intervertir(X1, Y1)
	fsi
	si X2 > Y2 alors
		intervertir(X2, Y2)
	fsi
	si X3 > Y3 alors
		intervertir(X3, Y3)
	fsi
	si X1 > X2 alors
		intervertir(X1, X2)
	fsi
	si X1 > X3 alors
		intervertir(X1, X3)
	fsi
	sortir("Résultat : ", X1, " ", X2, " ", X3, " ", Y1, " ", Y2, " ", Y3)
fin
